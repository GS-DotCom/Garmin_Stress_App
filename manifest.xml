<?xml version="1.0"?>
<!--
    Manifest dell'app StressGuard.
    - type="watch-app": app del dispositivo (in seguito diventerà un widget).
    - minApiLevel 3.3.0: necessario per SensorHistory.getStressHistory().
    - Permessi:
        Background     -> servizio in background ogni 5 minuti
        SensorHistory  -> lettura dello storico dello stress
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application id="41a6d5b46a2e429a8fddece4875e2d56"
                    type="watch-app"
                    name="@Strings.AppName"
                    entry="StressGuardApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.3.0"
                    version="0.1.0">

        <iq:products>
            <iq:product id="fenix6pro"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Background"/>
            <iq:uses-permission id="SensorHistory"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>ita</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
